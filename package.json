{
  "name": "luca",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source game platform: engine + collection of games. MIT-licensed.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "rm -rf packages/*/dist packages/*/.tsbuildinfo docs/.vitepress/dist docs/.vitepress/cache docs/reference",
    "docs:api": "typedoc",
    "docs:dev": "vitepress dev docs",
    "docs:build": "npm run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "llms:full": "node scripts/gen-llms-full.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "vitepress": "^1.6.4"
  }
}
